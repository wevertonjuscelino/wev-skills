{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wev config",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "language": { "enum": ["en", "pt-BR"] },
    "state_dir": { "type": "string", "minLength": 1 },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": { "enum": ["local", "jev"] },
        "jev": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": { "type": "string", "minLength": 1 },
            "timeout_seconds": { "type": "number", "minimum": 0.1 }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tiers": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "economy": { "$ref": "#/$defs/modelList" },
            "standard": { "$ref": "#/$defs/modelList" },
            "premium": { "$ref": "#/$defs/modelList" }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": { "type": "integer", "minimum": 1 },
        "max_parallel": { "type": "integer", "minimum": 1 },
        "max_consecutive_failures": { "type": "integer", "minimum": 1 },
        "max_identical_commands": { "type": "integer", "minimum": 1 },
        "task_timeout_seconds": { "type": "number", "minimum": 1 },
        "budget_units": { "type": "number", "minimum": 0 },
        "max_polling_commands": { "type": "integer", "minimum": 1 },
        "lock_timeout_seconds": { "type": "number", "minimum": 0 },
        "run_budget_units": { "type": "number", "minimum": 1 },
        "run_max_attempts_total": { "type": "integer", "minimum": 1 }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "budget_tokens": { "type": "integer", "minimum": 1 },
        "elide_at": { "type": "number", "minimum": 0, "maximum": 1 },
        "summarize_at": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_commands": { "$ref": "#/$defs/stringList" },
        "denied_commands": { "$ref": "#/$defs/stringList" },
        "allow_shell": { "type": "boolean" },
        "protected_paths": { "$ref": "#/$defs/stringList" },
        "approval_ttl_seconds": { "type": "number", "minimum": 1 },
        "exec_path": { "$ref": "#/$defs/stringList" }
      }
    },
    "remote": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["alias"],
            "additionalProperties": false,
            "properties": {
              "alias": { "type": "string", "minLength": 1 },
              "environment": { "type": "string" },
              "allow_mutating": { "type": "boolean" }
            }
          }
        }
      }
    },
    "agents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directories": { "$ref": "#/$defs/stringList" },
        "default_agent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "allow_override": { "type": "boolean" },
        "project_dir": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "planning": { "enum": ["auto", "always", "never"] },
        "executor_tier": { "enum": ["auto", "economy", "standard", "premium"] },
        "plan_reminder": { "type": "boolean" },
        "plan_reminder_max_chars": { "type": "integer", "minimum": 80, "maximum": 20000 },
        "tool_profile": { "enum": ["auto", "structured", "lean"] },
        "tool_selection": { "enum": ["off", "local", "provider"] },
        "baseline_checks": { "type": "boolean" }
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_rounds": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "specialists": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_per_project": { "type": "integer", "minimum": 1, "maximum": 20 },
        "max_lessons_rendered": { "type": "integer", "minimum": 1, "maximum": 50 },
        "max_lessons": { "type": "integer", "minimum": 1, "maximum": 30 },
        "stale_after_runs": { "type": "integer", "minimum": 1 },
        "score_samples": { "type": "integer", "minimum": 1, "maximum": 10 },
        "score_max_runs": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "score_max_new_lessons": { "type": "integer", "minimum": 0, "maximum": 10 },
        "score_timeout_seconds": { "type": "number", "minimum": 0.1, "maximum": 3600 },
        "score_on_finish": { "type": "boolean" }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": { "type": "string" },
        "depth": { "enum": ["off", "quick", "standard", "deep"] },
        "finders": { "type": "integer", "minimum": 0, "maximum": 10 },
        "verifiers": { "type": "integer", "minimum": 0, "maximum": 10 },
        "quorum": { "type": "integer", "minimum": 0, "maximum": 10 },
        "max_rounds": { "type": "integer", "minimum": 1, "maximum": 10 },
        "full_rounds": { "type": "integer", "minimum": 0, "maximum": 10 },
        "max_runs_per_round": { "type": "integer", "minimum": 1, "maximum": 50 },
        "timeout_seconds": { "type": "number", "minimum": 0.1, "maximum": 3600 }
      }
    }
  },
  "$defs": {
    "stringList": { "type": "array", "items": { "type": "string" } },
    "modelList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
