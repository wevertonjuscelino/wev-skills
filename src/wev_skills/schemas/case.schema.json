{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wev case",
  "description": "A scored case: a real situation with an objective and a command that checks it.",
  "type": "object",
  "required": ["id", "title", "source", "ref", "agents", "base_commit", "objective", "check", "files"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "source": { "enum": ["e2e", "review", "revert", "incident"] },
    "ref": { "type": "string" },
    "agents": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "base_commit": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "check": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "files": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
