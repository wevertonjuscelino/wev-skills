{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wev agent spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "description"],
  "$defs": {
    "agent_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name_text": {
      "type": ["string", "object"],
      "minLength": 1,
      "maxLength": 120,
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1, "maxLength": 120 },
        "pt-BR": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    },
    "short_text": {
      "type": ["string", "object"],
      "minLength": 1,
      "maxLength": 1024,
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "pt-BR": { "type": "string", "minLength": 1, "maxLength": 1024 }
      }
    },
    "long_text": {
      "type": ["string", "object"],
      "minLength": 1,
      "maxLength": 20000,
      "required": ["en"],
      "additionalProperties": false,
      "properties": {
        "en": { "type": "string", "minLength": 1, "maxLength": 20000 },
        "pt-BR": { "type": "string", "minLength": 1, "maxLength": 20000 }
      }
    },
    "tier": { "enum": ["economy", "standard", "premium"] },
    "tool_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z][A-Za-z0-9_:*(). /-]*$"
    },
    "text_list": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/short_text" }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "text", "evidence", "created_at", "accepted_by"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "kind": { "enum": ["practice", "pitfall", "need"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 600 },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["run_id", "task_id"],
          "properties": {
            "run_id": { "type": "string", "minLength": 1, "maxLength": 64 },
            "task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
            "records": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "id"],
                "properties": {
                  "type": { "type": "string", "minLength": 1, "maxLength": 64 },
                  "id": { "type": "string", "minLength": 1, "maxLength": 200 }
                }
              }
            }
          }
        },
        "created_at": { "type": "string", "minLength": 1, "maxLength": 40 },
        "accepted_by": { "type": "string", "minLength": 1, "maxLength": 64 },
        "confirmations": { "type": "integer", "minimum": 0 },
        "contradictions": { "type": "integer", "minimum": 0 },
        "last_seen_run": { "type": "string", "maxLength": 64 },
        "status": { "enum": ["active", "stale", "retired"] },
        "derivation": { "type": "string", "maxLength": 64 },
        "key": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "maxLength": 400 }
        },
        "contains_authored_text": { "type": "boolean" },
        "authored": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "text"],
            "properties": {
              "label": { "type": "string", "minLength": 1, "maxLength": 64 },
              "text": { "type": "string", "maxLength": 400 }
            }
          }
        },
        "note": { "type": "string", "maxLength": 400 },
        "shown_verified": { "type": "integer", "minimum": 0 },
        "shown_unverified": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/agent_id" },
    "name": { "$ref": "#/$defs/name_text" },
    "description": { "$ref": "#/$defs/short_text" },
    "specialties": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "instructions": { "$ref": "#/$defs/long_text" },
    "responsibilities": { "$ref": "#/$defs/text_list" },
    "extends": { "$ref": "#/$defs/agent_id" },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "model_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_tier": { "$ref": "#/$defs/tier" },
        "max_tier": { "$ref": "#/$defs/tier" },
        "escalate_on_failure": { "type": "boolean" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allow": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/tool_name" }
        },
        "deny": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/tool_name" }
        }
      }
    },
    "skills": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9:-]*$"
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": { "enum": ["plan", "execute"] }
        },
        "max_risk": { "enum": ["low", "medium", "high"] },
        "may_mutate": { "type": "boolean" },
        "may_use_remote": { "type": "boolean" },
        "ceiling": { "type": "boolean" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_units": { "type": "number", "minimum": 1 }
      }
    },
    "timeout_seconds": { "type": "number", "minimum": 1 },
    "max_attempts": { "type": "integer", "minimum": 1, "maximum": 100 },
    "success_criteria": { "$ref": "#/$defs/text_list" },
    "escalation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "on_failure": {
          "enum": [
            "continue", "change_strategy", "reduce_scope", "escalate", "ask_human", "stop"
          ]
        },
        "to": { "$ref": "#/$defs/agent_id" }
      }
    },
    "required_checks": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "output_format": { "$ref": "#/$defs/long_text" },
    "stop_conditions": { "$ref": "#/$defs/text_list" },
    "experience": {
      "type": "array",
      "maxItems": 500,
      "items": { "$ref": "#/$defs/lesson" }
    }
  }
}
