{
  "language": "en",
  "state_dir": ".wev",
  "decision": {
    "provider": "local",
    "jev": { "command": "/absolute/path/to/jev" }
  },
  "limits": {
    "max_attempts": 3,
    "max_parallel": 3
  },
  "remote": {
    "hosts": [
      { "alias": "staging-1", "environment": "staging", "allow_mutating": false },
      { "alias": "prod-1", "environment": "production", "allow_mutating": false }
    ]
  }
}
